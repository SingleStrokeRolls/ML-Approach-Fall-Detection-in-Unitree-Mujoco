<mujoco model="H2 with Cushion">
  <compiler meshdir="../shared/meshes" />
  <include file="../shared/H2_modified_high_damping.xml" />
  <statistic center="1 0.7 1.5" extent="0.8" />
  <visual>
    <headlight diffuse="0.9 0.9 0.9" ambient="0.1 0.1 0.1" specular="0.9 0.9 0.9"/>
    <!--<rgba haze="0.15 0.25 0.35 1" />-->
    <global azimuth="-140" elevation="-30" />
  </visual>
  <asset>
    <texture type="skybox" builtin="flat" rgb1="0.9 0.9 0.9" rgb2="0.9 0.9 0.9" width="512" height="3072" />
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.5 0.5 0.5"
      rgb2="0.5 0.5 0.5" markrgb="0.8 0.8 0.8" width="300" height="300" />
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5"
      reflectance="0.2" />
    <material name="soft_pad_mat" rgba="0.2 0.6 0.9 0.8" specular="0.1" shininess="0.1"/>
  </asset>
  <worldbody>
    <light pos="0 0 1.5" dir="0 0 -1" directional="true" />
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane" />


    <!-- Cushion - 高度10cm版本 -->
    <body name="soft_pad_base" pos="-0.65 0.5 0.025"> 
      <!-- 底层 - 最硬 (高度0-0.025m) -->
      <geom name="pad_layer1" type="box" size="1.0 1.0 0.025" 
            material="soft_pad_mat" mass="2.0"
            solref="0.005 2.0" solimp="0.99 0.9999 0.00001"/>
      
      <!-- 第二层 - 较硬 (高度0.025-0.05m) -->
      <body name="pad_layer2" pos="0 0 0.025">
          <joint name="layer2_z" type="slide" axis="0 0 1" 
                  range="-0.02 0" damping="1500" stiffness="2000"/>
          <geom name="pad_geom2" type="box" size="1.0 1.0 0.025" 
                material="soft_pad_mat" mass="1.5"
                solref="0.02 2.0" solimp="0.98 0.999 0.0001"/>
          
          <!-- 第三层 - 较软 (高度0.05-0.075m) -->
          <body name="pad_layer3" pos="0 0 0.025">
              <joint name="layer3_z" type="slide" axis="0 0 1" 
                      range="-0.0225 0" damping="1000" stiffness="750"/>
              <geom name="pad_geom3" type="box" size="1.0 1.0 0.025" 
                    material="soft_pad_mat" mass="1.0"
                    solref="0.05 1.5" solimp="0.95 0.995 0.001"/>
              
              <!-- 表面层 - 最软 (高度0.075-0.1m) -->
              <body name="pad_surface" pos="0 0 0.025">
                  <joint name="surface_z" type="slide" axis="0 0 1" 
                          range="-0.0225 0" damping="600" stiffness="250"/>
                  <geom name="pad_surface_geom" type="box" size="1.0 1.0 0.025" 
                        material="soft_pad_mat" mass="0.6"
                        solref="0.1 1.2" solimp="0.9 0.99 0.01"/>
              </body>
          </body>
      </body>
    </body>

  </worldbody>
</mujoco>
